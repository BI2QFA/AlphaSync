<?xml version="1.0" encoding="utf-8"?>
<!-- 版本号的**权威在 app/build.gradle 的 defaultConfig**（构建合并时 Gradle 覆盖此处值）；
     这里同步维护一份只为直接查看方便 —— 升版本时两处一起改（PtpCodec.APP_VERSION 同改）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.bi2qfa.alphasync" android:versionCode="1" android:versionName="1.0">

    <uses-sdk android:minSdkVersion="10" android:targetSdkVersion="10" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Black.NoTitleBar">

        <!-- 相机平台会话结束广播：Activity.onDestroy 可能不执行，这里是最后兜底 -->
        <receiver android:name=".ExitCompletedReceiver">
            <intent-filter>
                <action android:name="com.android.server.DAConnectionManagerService.ExitCompleted" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- 静态分析定版：PMCA 应用单进程铁律——不再有任何探针服务/子进程/原生库 -->
        <!-- 2.7 边拍边传：进入后台运行后的无线电重建服务（交接窗口内前台 + 唤醒锁保活；
             重建完成即 stopSelf，不是常驻服务） -->
        <service android:name=".RadioReattachService" />

        <activity android:name=".MainActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
